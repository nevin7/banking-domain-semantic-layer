# ════════════════════════════════════════════════════════════
# OWL 2 RL REASONING EXTENSIONS (Aligned to graphdb-mcp-server.js)
# ════════════════════════════════════════════════════════════

# ── New Classes & Controlled Status Individuals ──

:SecuredBorrower
    a owl:Class ;
    rdfs:subClassOf :Customer ;
    rdfs:label "Secured Borrower" ;
    skos:prefLabel "Secured Borrower" ;
    skos:definition "A customer who holds at least one account secured by pledged collateral." ;
    :termOwner "Credit Risk" ;
    :status "Approved" ;
    skos:inScheme :BankingDomainConceptScheme .

:PerformanceStatus
    a owl:Class ;
    rdfs:label "Performance Status" ;
    skos:prefLabel "Performance Status" ;
    skos:definition "Discrete delinquency status bucket assigned to a loan account upstream of OWL reasoning." ;
    :termOwner "Credit Risk" ;
    :status "Approved" ;
    skos:inScheme :BankingDomainConceptScheme .

:Current
    a :PerformanceStatus ;
    rdfs:label "Current" .

:Delinquent30To89
    a :PerformanceStatus ;
    rdfs:label "Delinquent 30-89 Days" .

:Delinquent90Plus
    a :PerformanceStatus ;
    rdfs:label "Delinquent 90+ Days" .


# ── New Object Properties ──

# CQ1: Derived property — never asserted directly in ABox
:isSubjectTo
    a owl:ObjectProperty ;
    rdfs:label "is subject to" ;
    rdfs:domain :Customer ;
    rdfs:range :RegulatoryFramework ;
    skos:definition "Relates a customer to a regulatory framework that governs one or more of their held accounts." ;
    owl:propertyChainAxiom ( :holdsAccount :governedBy ) .

# CQ4: Links a loan to its discrete performance status bucket
:hasPerformanceStatus
    a owl:ObjectProperty ;
    rdfs:label "has performance status" ;
    rdfs:domain :LoanAccount ;
    rdfs:range :PerformanceStatus ;
    skos:definition "Relates a loan account to its current delinquency/performance status category." .


# ── OWL 2 RL General Class Axioms ──

# CQ2: Customer ⊓ ∃holdsAccount.(∃isSecuredBy.Collateral) ⊑ SecuredBorrower
[ a owl:Class ;
  owl:intersectionOf (
    :Customer
    [ a owl:Restriction ;
      owl:onProperty :holdsAccount ;
      owl:someValuesFrom [
        a owl:Restriction ;
        owl:onProperty :isSecuredBy ;
        owl:someValuesFrom :Collateral
      ]
    ]
  )
] rdfs:subClassOf :SecuredBorrower .

# CQ4: LoanAccount ⊓ ∃hasPerformanceStatus.{Delinquent90Plus} ⊑ NonPerformingLoan
[ a owl:Class ;
  owl:intersectionOf (
    :LoanAccount
    [ a owl:Restriction ;
      owl:onProperty :hasPerformanceStatus ;
      owl:hasValue :Delinquent90Plus
    ]
  )
] rdfs:subClassOf :NonPerformingLoan .

